WindowWidgetClass CarLockFrame {
 clipchildren 0
 position 0 0
 size 300 196
 halign center_ref
 valign center_ref
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 style blank
 {
  PanelWidgetClass CarLockPanel {
   ignorepointer 1
   color 1 1 1 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style TPV2Panel
   {
    ButtonWidgetClass BttnCancel {
     "text color" 0.7216 0.6627 0.5804 1
     color 1 1 1 1
     position 8 8
     size 32 32
     halign right_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style TPV2IconBtn
     text "X"
     text_proportion 0.5
     font "TraderPlus/gui/fonts/tpcond18"
    }
    TextWidgetClass TextOutPut {
     "exact text size" 17
     color 0.9529 0.9137 0.8549 1
     ignorepointer 1
     position 16 8
     size 220 32
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "ENTER PASSCODE"
     font "TraderPlus/gui/fonts/tpcond18"
     "exact text" 1
     text_proportion 0.75
     "size to text h" 1
     "text halign" left
     "text valign" center
    }
    EditBoxWidgetClass PasswordInput {
     "text halign" center
     "exact text size" 26
     color 0.9529 0.9137 0.8549 1
     position 16 58
     size 268 48
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     scaled 1
     style TPV2Field
     "no focus" 0
     "next left" ""
     text ""
     "limit visible" 0
     "Use default text" 0
     "exact text" 1
     font "TraderPlus/gui/fonts/tpcond28"
     "text color" 0.749 0.6078 0.1882 1
     "text sharpness" 2.838
    }
    PanelWidgetClass seperatorPanel {
     ignorepointer 1
     color 1 1 1 1
     position 16 106
     size 268 2
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style TPV2Accent
    }
    ButtonWidgetClass BttnOK {
     "text color" 0.1020 0.0706 0.0392 1
     color 1 1 1 1
     keepsafezone 0
     position 16 16
     size 268 48
     valign bottom_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style TPV2BtnAccent
     text "SET CAR PASSWORD"
     text_proportion 0.5
     font "TraderPlus/gui/fonts/tpcond18"
    }
   }
  }
 }
}