PanelWidgetClass CarLockFrame {
 color 1 1 1 1
 style TPV2Panel
 halign center_ref
 valign center_ref
 position 0 0
 size 300 214
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
  PanelWidgetClass CarLockBar {
   ignorepointer 1
   color 1 1 1 1
   style TPV2Bar
   position 0 0
   size 300 46
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    TextWidgetClass TextOutPut {
     ignorepointer 1
     color 0.9529 0.9137 0.8549 1
     font "TraderPlus/gui/fonts/tpcond18"
     position 14 0
     size 230 46
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "ENTER PASSCODE"
     "text halign" left
     "text valign" center
     "exact text" 1
     "exact text size" 17
    }
    ButtonWidgetClass BttnCancel {
     color 1 1 1 1
     style TPV2IconBtn
     position 6 6
     size 34 34
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     halign right_ref
     text "X"
     font "TraderPlus/gui/fonts/tpcond18"
     "text color" 0.7216 0.6627 0.5804 1
     "exact text" 1
     "exact text size" 16
    }
   }
  }
  TextWidgetClass PasscodeLabel {
   ignorepointer 1
   color 0.7216 0.6627 0.5804 1
   font "TraderPlus/gui/fonts/tpinter12"
   position 16 56
   size 268 18
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "PASSCODE"
   "text halign" left
   "text valign" center
   "exact text" 1
   "exact text size" 12
  }
  PanelWidgetClass PasswordField {
   ignorepointer 0
   color 1 1 1 1
   style TPV2Field
   position 16 76
   size 268 48
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    EditBoxWidgetClass PasswordInput {
     color 0.9529 0.9137 0.8549 1
     style ServerBrowser
     text ""
     font "TraderPlus/gui/fonts/tpcond28"
     "exact text" 1
     "exact text size" 26
     "text halign" center
     position 12 0
     size 244 48
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
    }
   }
  }
  PanelWidgetClass seperatorPanel {
   ignorepointer 1
   color 1 1 1 1
   style TPV2Accent
   position 16 126
   size 268 2
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
  }
  ButtonWidgetClass BttnOK {
   color 1 1 1 1
   style TPV2BtnAccent
   position 16 16
   size 268 48
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   valign bottom_ref
   text "SET CAR PASSWORD"
   font "TraderPlus/gui/fonts/tpcond18"
   "text color" 0.1020 0.0706 0.0392 1
   "exact text" 1
   "exact text size" 18
  }
 }
}
