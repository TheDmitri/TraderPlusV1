FrameWidgetClass rootFrame {
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass PanelStock {
   ignorepointer 1
   color 0.996 0.996 0.996 1
   position 0.00172 0.00252
   size 0.99579 0.99479
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style TXCard
   {
    GridSpacerWidgetClass GridLeft {
     ignorepointer 1
     position 0 0
     size 1 1
     halign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Colorable
     Padding 5
     Margin 10
     "Size To Content V" 1
     Columns 1
     {
      XComboBoxWidgetClass StockCategories {
       color 1 1 1 0.7843
       position 0 4.30092
       size 1.0005 42.2904
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 1
       style Default
       font "gui/fonts/etelkatextpro22"
       items "ALL"
      }
      GridSpacerWidgetClass GridSearchLeft {
       ignorepointer 1
       position 10 10
       size 48 52
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       Padding 0
       Margin 0
       "Size To Content H" 1
       "Size To Content V" 1
       content_valign center
       Columns 4
       Rows 1
       {
        ImageWidgetClass SearchLeft {
         ignorepointer 1
         position 0 0
         size 30 30
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         imageTexture "{F314F4772CEF6D8D}TraderPlus/gui/loupe.edds"
         mode blend
         "src alpha" 1
         stretch 1
        }
        EditBoxWidgetClass SearchStockBox {
         position 0.15635 -0.06361
         size 0.84365 26.9461
         halign right_ref
         valign center_ref
         hexactpos 0
         vexactpos 1
         hexactsize 0
         vexactsize 1
         style Default
         text "#tpm_search"
         "Use default text" 1
         "exact text" 0
         font "gui/fonts/etelkatextpro22"
        }
        GridSpacerWidgetClass ShowAllGrid {
         ignorepointer 1
         position 0 -0.42415
         size 0.02192 1.32515
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         Padding 0
         Margin 0
         "Size To Content H" 1
         content_halign center
         content_valign center
         Columns 2
         Rows 1
         {
          TextWidgetClass TextWidget2 {
           ignorepointer 1
           position 0 0
           size 0.19873 0.48041
           hexactpos 0
           vexactpos 0
           hexactsize 0
           vexactsize 0
           text "#tpm_showall"
           font "TraderPlus/gui/fonts/regular12"
           "exact text" 1
           "size to text h" 1
           "size to text v" 1
           "text valign" center
          }
          CheckBoxWidgetClass ShowAllCheckBox {
           color 0.5255 0.549 0.5882 1
           position -0.81421 -0.52574
           size 1.28421 2.11674
           hexactpos 0
           vexactpos 0
           hexactsize 0
           vexactsize 0
           style Default
           font "gui/fonts/etelkatextpro22"
           "text color" 0.5255 0.549 0.5882 1
           "disabled text color" 0.5255 0.549 0.5882 1
          }
         }
        }
       }
      }
      ScrollWidgetClass StockScrollWidget {
       ignorepointer 1
       position 0 0
       size 0.98 1.0016
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       "Scrollbar V" 1
       {
        GridSpacerWidgetClass StockForEachGrid {
         ignorepointer 1
         position 0 0
         size 1 1
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         scriptclass "ComponentWidgetBinding"
         Padding 5
         "Size To Content V" 1
         Columns 1
         Rows 100
         {
          ScriptParamsClass {
           Component_ForEach "{{ _inputStockItems }}"
           Component_Template "stock-category-card-component"
           Component_ItemProperty "_inputCategoryItems"
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
