FrameWidgetClass rootFrame {
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass PanelInventory {
   ignorepointer 1
   color 0.996 0.996 0.996 1
   position 0.00261 0.00283
   size 0.99435 0.99266
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style TXCard
   {
    GridSpacerWidgetClass GridRight {
     ignorepointer 1
     position -0.00163 -0.00023
     size 0.99694 0.99923
     halign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     Padding 5
     Margin 10
     "Size To Content V" 1
     Columns 1
     {
      XComboBoxWidgetClass InventoryCategories {
       position 0 0.29267
       size 1.01255 39.7073
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 1
       style Default
       font "gui/fonts/etelkatextpro22"
       items "ALL"
      }
      GridSpacerWidgetClass GridSearchInventory {
       ignorepointer 1
       position 10 10
       size 48 52
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       Padding 0
       Margin 0
       "Size To Content H" 1
       "Size To Content V" 1
       content_valign center
       Columns 4
       Rows 1
       {
        ImageWidgetClass SearchInventory {
         ignorepointer 1
         position 0 0
         size 30 30
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         imageTexture "{F314F4772CEF6D8D}TraderPlus/gui/loupe.edds"
         mode blend
         "src alpha" 1
         stretch 1
        }
        EditBoxWidgetClass SearchInventoryBox {
         visible 1
         position 0 0
         size 1 30
         hexactpos 0
         vexactpos 1
         hexactsize 0
         vexactsize 1
         style Default
         text "#tpm_search"
         "Use default text" 1
         "exact text" 0
         font "gui/fonts/etelkatextpro22"
        }
       }
      }
      PanelWidgetClass InventoryListContainer {
       visible 1
       ignorepointer 1
       position 0 0
       size 0.98 1.0016
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       {
        ScrollWidgetClass InventoryScrollWidget {
         ignorepointer 1
         position 0 0
         size 1 1
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         "Scrollbar V" 1
         {
          GridSpacerWidgetClass InventoryForEachGrid {
           ignorepointer 1
           position 0 0
           size 1 1
           hexactpos 0
           vexactpos 0
           hexactsize 0
           vexactsize 0
           scriptclass "ComponentWidgetBinding"
           Padding 8
           Margin 5
           "Size To Content V" 1
           Columns 6
           Rows 100
           {
            ScriptParamsClass {
             Component_ForEach "{{ _inputPlayerItems }}"
             Component_Template "inventory-product-card-component"
             Component_ItemProperty "_inputArticle"
            }
           }
          }
         }
        }
       }
      }
      PanelWidgetClass InsuranceListContainer {
       visible 0
       ignorepointer 1
       position 0 0
       size 0.98 1.0016
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       {
        ScrollWidgetClass InsuranceScrollWidget {
         ignorepointer 1
         position 0 0
         size 1 1
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         "Scrollbar V" 1
         {
          GridSpacerWidgetClass InsuranceForEachGrid {
           ignorepointer 1
           position 0 0
           size 1 1
           hexactpos 0
           vexactpos 0
           hexactsize 0
           vexactsize 0
           scriptclass "ComponentWidgetBinding"
           Padding 8
           Margin 5
           "Size To Content V" 1
           Columns 6
           Rows 100
           {
            ScriptParamsClass {
             Component_ForEach "{{ _inputInsurances }}"
             Component_Template "insurance-card-component"
             Component_ItemProperty "_inputInsurance"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
