GridSpacerWidgetClass rootframe {
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 1
 style Empty
 "Size To Content H" 1
 "Size To Content V" 1
 content_halign center
 content_valign center
 Columns 1
 Rows 1
 {
  PanelWidgetClass CategoryCardPanel {
   visible 1
   ignorepointer 1
   color 0.996 0.996 0.996 1
   size 1 49
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 1
   style TXCategoryItem
   {
    PanelWidgetClass TitleBackground {
     visible 1
     ignorepointer 1
     color 0.996 0.996 0.996 1
     size 0.995 44
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 1
     style TXCard
    }
    TextWidgetClass Title {
     visible 1
     ignorepointer 1
     position 21.6083 -0.36264
     size 0.83229 0.90573
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     priority 1
     scriptclass "TextBinding"
     style Normal
     font "TraderPlus/gui/fonts/regular22"
     "text color" 0.878 0.878 0.878 1
     "exact text" 0
     "text halign" left
     "text valign" center
     {
      ScriptParamsClass {
       Binding_Expression "{{ categoryName }}"
      }
     }
    }
    ButtonWidgetClass BttnCategory {
     visible 1
     clipchildren 0
     ignorepointer 0
     color 0.996 0.996 0.996 1
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     userID 20062003
     scriptclass "ButtonBinding"
     style TXCategoryItem
     {
      ScriptParamsClass {
       OnClick "OnToggleProducts"
      }
     }
    }
    TextWidgetClass ProductsCount {
     ignorepointer 1
     position 0.82 0.06401
     size 0.155 0.88178
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     scriptclass "TextBinding"
     font "TraderPlus/gui/fonts/regular22"
     "text color" 0.533 0.533 0.533 1
     "text halign" right
     "text valign" center
     {
      ScriptParamsClass {
       Binding_Expression "{{ productCount }}"
      }
     }
    }
   }
  }
  GridSpacerWidgetClass ProductsList {
   visible 0
   ignorepointer 1
   position 0 50
   size 1 0.5
   hexactpos 0
   vexactpos 1
   hexactsize 0
   vexactsize 0
   scriptclass "ComponentWidgetBinding"
   Padding 8
   Margin 5
   "Size To Content V" 1
   Columns 6
   Rows 100
   {
    ScriptParamsClass {
     Component_ForEach "{{ _inputProducts }}"
     Component_Template "stock-product-card-component"
     Component_ItemProperty "_inputArticle"
    }
   }
  }
 }
}
